      "parameters": {
        "jsCode": "return $input.all().map((item, i) => {\n  const j = item.json;\n  const text = (j.snippet || '') + ' ' + (j.emailText || '') + ' ' + (j.subject || '');\n  const urls = [...text.matchAll(/https?:\\/\\/[^\\s\"'<>\\)]+/g)].map(m => m[0]);\n  const unique = [...new Set(urls)].slice(0, 3);\n\n  return {\n    json: {\n      id: j.id || '',\n      url: unique[0] || null,\n      urls: unique,\n      urlCount: unique.length,\n      skipped: unique.length === 0\n    },\n    pairedItem: { item: i }\n  };\n});"
      },
