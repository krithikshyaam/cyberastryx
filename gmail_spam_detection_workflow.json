        "jsCode": "const item = $input.first().json;\n\n// If previous step was skipped, pass skip forward\nif (item.skipped) {\n  return [{ json: { image_url: null, skipped: true } }];\n}\n\nconst body = item.emailBody || item.snippet || item.body || item.text || \"\";\nconst imgs = [...body.matchAll(/https?:\\/\\/[^\\s\"<>]+\\.(?:jpg|jpeg|png|gif|webp|bmp)/gi)].map(m => m[0]);\n\nif (imgs.length === 0) {\n  return [{ json: { image_url: null, skipped: true } }];\n}\n\nreturn imgs.slice(0, 3).map(url => ({ json: { image_url: url, skipped: false } }));"
